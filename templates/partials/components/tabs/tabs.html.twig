{#
    Generic Bootstrap Tabs component.

    Responsibilities:
    - render the base Bootstrap Tabs structure,
    - require a stable HTML id,
    - allow additional CSS classes to be passed,
    - expose blocks for tab navigation and tab panels.

    Available blocks:
    - tabs_navigation
    - tabs_content

    Expected variables:
    - id
    - classes

    Usage example:

    {% embed 'partials/components/tabs/tabs.html.twig' with {
        id: 'example-tabs'
    } only %}
        {% block tabs_navigation %}
            ...
        {% endblock %}

        {% block tabs_content %}
            ...
        {% endblock %}
    {% endembed %}

    This component contains no page-specific or Grav Page logic.
    Concrete implementations should provide their navigation and panels
    through the exposed blocks.
#}

{% set classes = classes ?? null %}

<div
    class="tabs{% if classes %} {{ classes|e('html_attr') }}{% endif %}"
    id="{{ id|e('html_attr') }}"
>
    <ul
        class="nav nav-tabs"
        role="tablist"
    >
        {% block tabs_navigation %}{% endblock %}
    </ul>

    <div class="tab-content">
        {% block tabs_content %}{% endblock %}
    </div>
</div>
