{#
    Generic responsive Section component.

    Provides an optional full-row header followed by
    two responsive content columns.

    Parameters:
    - id: Optional section ID.
    - classes: Additional section classes.
    - attributes: Additional HTML attributes.
    - container_classes: Container classes.
    - row_classes: Row classes.
    - header_classes: Header column classes.
    - primary_classes: Primary column classes.
    - secondary_classes: Secondary column classes.

    Blocks:
    - section_header
    - section_primary
    - section_secondary

    Example:

    {% embed 'partials/components/section/section.html.twig' with {
        id: 'about',
        classes: 'py-5',
        row_classes: 'row g-4 align-items-center',
        primary_classes: 'col-12 col-lg-6',
        secondary_classes: 'col-12 col-lg-6'
    } only %}
        {% block section_header %}
            {% include 'partials/elements/heading.html.twig' with {
                text: 'About us',
                level: 2
            } only %}
        {% endblock %}

        {% block section_primary %}
            Primary content.
        {% endblock %}

        {% block section_secondary %}
            Secondary content.
        {% endblock %}
    {% endembed %}
#}

{% import 'macros/attributes.html.twig' as html_attributes %}

{% set id = id ?? null %}
{% set classes = classes ?? '' %}
{% set attributes = attributes ?? {} %}
{% set container_classes = container_classes ?? 'container' %}
{% set row_classes = row_classes ?? 'row' %}
{% set header_classes = header_classes ?? 'col-12' %}
{% set primary_classes = primary_classes ?? 'col-12 col-lg-6' %}
{% set secondary_classes = secondary_classes ?? 'col-12 col-lg-6' %}

{% set header_content %}
    {% block section_header %}{% endblock %}
{% endset %}

{% set primary_content %}
    {% block section_primary %}{% endblock %}
{% endset %}

{% set secondary_content %}
    {% block section_secondary %}{% endblock %}
{% endset %}

<section
    {% if id %}
        id="{{ id|e('html_attr') }}"
    {% endif %}
    {% if classes %}
        class="{{ classes|e('html_attr') }}"
    {% endif %}

    {{ html_attributes.render(attributes, ['id', 'class']) }}
>
    <div class="{{ container_classes|e('html_attr') }}">
        <div class="{{ row_classes|e('html_attr') }}">
            {% if header_content|trim %}
                <div class="{{ header_classes|e('html_attr') }}">
                    {{ header_content|raw }}
                </div>
            {% endif %}

            {% if primary_content|trim %}
                <div class="{{ primary_classes|e('html_attr') }}">
                    {{ primary_content|raw }}
                </div>
            {% endif %}

            {% if secondary_content|trim %}
                <div class="{{ secondary_classes|e('html_attr') }}">
                    {{ secondary_content|raw }}
                </div>
            {% endif %}
        </div>
    </div>
</section>
