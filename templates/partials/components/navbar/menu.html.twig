{#
    Navbar menu component.

    Renders the visible Grav page tree using the navigation macro.
    Dropdowns and menu icons are controlled by the theme configuration.
#}

{% import 'macros/navigation.html.twig' as navigation %}

{% set dropdown_enabled = config.theme.dropdown.enabled ?? true %}
{% set dropdown_trigger = config.theme.navbar.dropdown.trigger ?? 'standard' %}
{% set icons_enabled = config.theme.icons.enabled ?? true %}

<ul class="navbar-nav me-auto">
    {{ navigation.render(
        pages.children.visible,
        dropdown_enabled,
        dropdown_trigger,
        icons_enabled,
        pages
    ) }}
</ul>
