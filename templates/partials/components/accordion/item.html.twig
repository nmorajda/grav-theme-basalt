{#
    Generic Bootstrap Accordion item component.

    Responsibilities:
    - render a single Bootstrap Accordion item,
    - connect the trigger with the collapsible content,
    - support the initial expanded state,
    - optionally connect the item to a parent accordion,
    - allow additional CSS classes to be passed,
    - expose blocks for the header and content.

    Available blocks:
    - accordion_header
    - accordion_content

    Expected variables:
    - id
    - parent_id
    - expanded
    - classes
    - heading_tag
#}

{% set parent_id = parent_id ?? null %}
{% set expanded = expanded ?? false %}
{% set classes = classes ?? null %}

{% set heading_id = id ~ '-heading' %}
{% set collapse_id = id ~ '-collapse' %}

{% set heading_tag = heading_tag ?? 'h2' %}

{% if not (heading_tag matches '/^h[2-6]$/') %}
    {% set heading_tag = 'h2' %}
{% endif %}

<div class="accordion-item{% if classes %} {{ classes|e('html_attr') }}{% endif %}">
    <{{ heading_tag }} class="accordion-header" id="{{ heading_id|e('html_attr') }}">
        <button
            class="accordion-button{% if not expanded %} collapsed{% endif %}"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#{{ collapse_id|e('html_attr') }}"
            aria-expanded="{{ expanded ? 'true' : 'false' }}"
            aria-controls="{{ collapse_id|e('html_attr') }}"
        >
            {% block accordion_header %}{% endblock %}
        </button>
    </{{ heading_tag }}>

    <div
        id="{{ collapse_id|e('html_attr') }}"
        class="accordion-collapse collapse{% if expanded %} show{% endif %}"
        aria-labelledby="{{ heading_id|e('html_attr') }}"
        {% if parent_id %}data-bs-parent="#{{ parent_id|e('html_attr') }}"{% endif %}
    >
        <div class="accordion-body">
            {% block accordion_content %}{% endblock %}
        </div>
    </div>
</div>