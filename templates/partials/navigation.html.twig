{% import 'macros/navigation.html.twig' as navigation %}

{% set dropdown_enabled = config.theme.dropdown.enabled ?? true %}
{% set icons_enabled = config.theme.icons.enabled ?? true %}

<nav
    class="navbar navbar-expand-lg"
    aria-label="{{ 'THEME_BASALT.ARIA.PRIMARY_NAVIGATION'|t|e('html_attr') }}"
>
    <div class="container">
        <a class="navbar-brand" href="{{ home_url|e('html_attr') }}">
            {{ site.title|e }}
        </a>

        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#main-navigation"
            aria-controls="main-navigation"
            aria-expanded="false"
            aria-label="{{ 'THEME_BASALT.TOGGLE_NAVIGATION'|t|e('html_attr') }}"
        >
            <span class="navbar-toggler-icon"></span>
        </button>

        <div id="main-navigation" class="collapse navbar-collapse">
            <ul class="navbar-nav">
                {{ navigation.render(
                    pages.children.visible,
                    dropdown_enabled,
                    icons_enabled
                ) }}
            </ul>
        </div>
    </div>
</nav>
