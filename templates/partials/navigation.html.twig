{% macro render(items, level) %}
    <ul class="site-navigation__list{% if level > 0 %} site-navigation__list--nested{% endif %}">
        {% for item in items %}
            {% set children = item.children.visible %}
            {% set is_active = item.active or item.activeChild %}

            <li class="site-navigation__item{% if is_active %} is-active{% endif %}">
                <a
                    class="site-navigation__link"
                    href="{{ item.url|e('html_attr') }}"
                    {% if item.active %}aria-current="page"{% endif %}
                >
                    {{ item.menu|e }}
                </a>

                {% if children|length %}
                    {{ _self.render(children, level + 1) }}
                {% endif %}
            </li>
        {% endfor %}
    </ul>
{% endmacro %}

{% set navigation_items = pages.children.visible %}

{% if navigation_items|length %}
    <nav
        class="site-navigation"
        aria-label="{{ 'THEME_BASALT.ARIA.PRIMARY_NAVIGATION'|t|e('html_attr') }}"
    >
        {{ _self.render(navigation_items, 0) }}
    </nav>
{% endif %}