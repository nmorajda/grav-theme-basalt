{#
    Link element.

    Available parameters:
    - label
    - href
    - target
    - rel
    - classes
    - attributes

    Examples:

    Internal link:
    {% include 'partials/elements/link.html.twig' with {
        label: 'About us',
        href: '/about'
    } %}

    External link:
    {% include 'partials/elements/link.html.twig' with {
        label: 'External documentation',
        href: 'https://example.com/docs',
        target: '_blank'
    } %}

    Link with additional classes and attributes:
    {% include 'partials/elements/link.html.twig' with {
        label: 'Contact us',
        href: '/contact',
        classes: 'fw-semibold',
        attributes: {
            'aria-label': 'Contact our team',
            'data-track': 'contact-link'
        }
    } %}
#}

{% import 'macros/attributes.html.twig' as html_attributes %}

{% set target = target|default(null) %}
{% set rel = rel|default(null) %}
{% set classes = classes|default('') %}
{% set attributes = attributes|default({}) %}

{% if target == '_blank' and not rel %}
    {% set rel = 'noopener' %}
{% endif %}

<a
    href="{{ href }}"
    {% if target %}target="{{ target }}"{% endif %}
    {% if rel %}rel="{{ rel }}"{% endif %}
    {% if classes %}class="{{ classes }}"{% endif %}
    {{ html_attributes.render(
        attributes,
        ['href', 'target', 'rel', 'class']
    ) }}
>
    {{ label }}
</a>
