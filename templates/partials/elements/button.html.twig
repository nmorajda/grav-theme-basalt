{#
    Button element.

    Available parameters:
    - label
    - variant
    - size
    - type
    - href
    - disabled
    - classes
    - attributes

    Examples:

    Basic button:
    {% include 'partials/elements/button.html.twig' with {
        label: 'Save',
        variant: 'primary',
        type: 'submit'
    } %}

    Link styled as a button:
    {% include 'partials/elements/button.html.twig' with {
        label: 'Learn more',
        variant: 'outline-primary',
        href: '/about'
    } %}

    Bootstrap component trigger:
    {% include 'partials/elements/button.html.twig' with {
        label: 'Open modal',
        attributes: {
            'data-bs-toggle': 'modal',
            'data-bs-target': '#exampleModal',
            'aria-controls': 'exampleModal'
        }
    } %}
#}

{% import 'macros/attributes.html.twig' as html_attributes %}

{% set variant = variant|default('primary') %}
{% set size = size|default(null) %}
{% set type = type|default('button') %}
{% set href = href|default(null) %}
{% set disabled = disabled|default(false) %}
{% set classes = classes|default('') %}
{% set attributes = attributes|default({}) %}

{% set button_classes = [
    'btn',
    'btn-' ~ variant,
    size ? 'btn-' ~ size : '',
    href and disabled ? 'disabled' : '',
    classes
]|filter(v => v)|join(' ') %}

{% if href %}
    <a
        class="{{ button_classes }}"
        {% if not disabled %}href="{{ href }}"{% endif %}
        {% if disabled %}
            aria-disabled="true"
            tabindex="-1"
        {% endif %}

        {% set excluded_attributes = ['class', 'href'] %}

        {% if disabled %}
            {% set excluded_attributes = excluded_attributes|merge([
                'aria-disabled',
                'tabindex'
            ]) %}
        {% endif %}

        {{ html_attributes.render(attributes, excluded_attributes) }}
    >
        {{ label }}
    </a>
{% else %}
    <button
        type="{{ type }}"
        class="{{ button_classes }}"
        {% if disabled %}disabled{% endif %}
        {{ html_attributes.render(
            attributes,
            ['class', 'type', 'disabled']
        ) }}
    >
        {{ label }}
    </button>
{% endif %}
