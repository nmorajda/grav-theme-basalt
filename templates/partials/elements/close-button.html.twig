{#
    Close Button element.

    Available parameters:
    - label
    - disabled
    - classes
    - attributes

    Examples:

    Basic close button:
    {% include 'partials/elements/close-button.html.twig' %}

    Close button on a dark background:
    {% include 'partials/elements/close-button.html.twig' with {
        attributes: {
            'data-bs-theme': 'dark'
        }
    } %}

    Bootstrap component dismiss trigger:
    {% include 'partials/elements/close-button.html.twig' with {
        attributes: {
            'data-bs-dismiss': 'modal'
        }
    } %}
#}

{% import 'macros/attributes.html.twig' as html_attributes %}

{% set label = label|default('THEME_BASALT.ARIA.CLOSE'|t) %}
{% set disabled = disabled|default(false) %}
{% set classes = classes|default('') %}
{% set attributes = attributes|default({}) %}

{% set close_button_classes = [
    'btn-close',
    classes
]|filter(v => v)|join(' ') %}

<button
    type="button"
    class="{{ close_button_classes }}"
    aria-label="{{ label }}"
    {% if disabled %}disabled{% endif %}
    {{ html_attributes.render(
        attributes,
        ['class', 'type', 'disabled', 'aria-label']
    ) }}
></button>
