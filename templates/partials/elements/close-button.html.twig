{#
    Close Button element.

    Available parameters:
    - label
    - disabled
    - classes
    - attributes

    Examples:

    Basic close button:
    {% include 'partials/elements/close-button.html.twig' %}

    Close button on a dark background:
    {% include 'partials/elements/close-button.html.twig' with {
        attributes: {
            'data-bs-theme': 'dark'
        }
    } %}

    Bootstrap component dismiss trigger:
    {% include 'partials/elements/close-button.html.twig' with {
        attributes: {
            'data-bs-dismiss': 'modal'
        }
    } %}
#}

{% set label = label|default('THEME_BASALT.ARIA.CLOSE'|t) %}
{% set disabled = disabled|default(false) %}
{% set classes = classes|default('') %}
{% set attributes = attributes|default({}) %}

{% set close_button_classes = [
    'btn-close',
    classes
]|filter(v => v)|join(' ') %}

<button
    type="button"
    class="{{ close_button_classes }}"
    aria-label="{{ label }}"
    {% if disabled %}disabled{% endif %}
    {% for attribute, value in attributes %}
        {% if attribute not in ['class', 'type', 'disabled', 'aria-label'] %}
            {% if attribute starts with 'aria-' or attribute starts with 'data-' %}
                {% if value is not null %}
                    {{ attribute }}="{{ value is same as(true) ? 'true' : (value is same as(false) ? 'false' : value) }}"
                {% endif %}
            {% elseif value is same as(true) %}
                {{ attribute }}
            {% elseif value is not same as(false) and value is not null %}
                {{ attribute }}="{{ value }}"
            {% endif %}
        {% endif %}
    {% endfor %}
></button>
