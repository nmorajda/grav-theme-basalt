{#
    Badge element.

    Available parameters:
    - label
    - variant
    - pill
    - classes
    - attributes

    Examples:

    Basic badge:
    {% include 'partials/elements/badge.html.twig' with {
        label: 'New'
    } %}

    Variant pill badge:
    {% include 'partials/elements/badge.html.twig' with {
        label: 'Active',
        variant: 'success',
        pill: true
    } %}

    Badge with additional attributes:
    {% include 'partials/elements/badge.html.twig' with {
        label: '3',
        variant: 'danger',
        attributes: {
            'aria-label': '3 unread messages',
            'data-count': 3
        }
    } %}
#}

{% set variant = variant|default('primary') %}
{% set pill = pill|default(false) %}
{% set classes = classes|default('') %}
{% set attributes = attributes|default({}) %}

{% set badge_classes = [
    'badge',
    'text-bg-' ~ variant,
    pill ? 'rounded-pill' : '',
    classes
]|filter(v => v)|join(' ') %}

<span
    class="{{ badge_classes }}"
    {% for attribute, value in attributes %}
        {% if attribute != 'class' %}
            {% if attribute starts with 'aria-' or attribute starts with 'data-' %}
                {% if value is not null %}
                    {{ attribute }}="{{ value is same as(true) ? 'true' : (value is same as(false) ? 'false' : value) }}"
                {% endif %}
            {% elseif value is same as(true) %}
                {{ attribute }}
            {% elseif value is not same as(false) and value is not null %}
                {{ attribute }}="{{ value }}"
            {% endif %}
        {% endif %}
    {% endfor %}
>{{ label }}</span>
