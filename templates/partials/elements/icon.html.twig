{#
    Icon element.

    Available parameters:
    - name
    - label
    - classes
    - attributes

    Examples:

    Decorative icon:
    {% include 'partials/elements/icon.html.twig' with {
        name: 'house'
    } %}

    Accessible icon:
    {% include 'partials/elements/icon.html.twig' with {
        name: 'download',
        label: 'Download'
    } %}

    Icon with additional classes:
    {% include 'partials/elements/icon.html.twig' with {
        name: 'check-circle',
        classes: 'fs-3 text-success'
    } %}
#}

{% set label = label|default(null) %}
{% set classes = classes|default('') %}
{% set attributes = attributes|default({}) %}

{% set icon_classes = [
    'bi',
    'bi-' ~ name,
    classes
]|filter(v => v)|join(' ') %}

<i
    class="{{ icon_classes }}"
    {% if label %}
        role="img"
        aria-label="{{ label }}"
    {% else %}
        aria-hidden="true"
    {% endif %}
    {% for attribute, value in attributes %}
        {% if attribute not in ['class', 'role', 'aria-label', 'aria-hidden'] %}
            {% if attribute starts with 'aria-' or attribute starts with 'data-' %}
                {% if value is not null %}
                    {{ attribute }}="{{ value is same as(true) ? 'true' : (value is same as(false) ? 'false' : value) }}"
                {% endif %}
            {% elseif value is same as(true) %}
                {{ attribute }}
            {% elseif value is not same as(false) and value is not null %}
                {{ attribute }}="{{ value }}"
            {% endif %}
        {% endif %}
    {% endfor %}
></i>
