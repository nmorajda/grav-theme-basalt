{#
    Heading element.

    Parameters:
    - text: Heading text.
    - level: Heading level from 1 to 6.
    - id: Optional heading ID.
    - classes: Additional CSS classes.
    - attributes: Additional HTML attributes.
#}

{% import 'macros/attributes.html.twig' as html_attributes %}

{% set text = text ?? null %}
{% set level = level ?? 2 %}
{% set id = id ?? null %}
{% set classes = classes ?? '' %}
{% set attributes = attributes ?? {} %}

{% if level not in [1, 2, 3, 4, 5, 6] %}
    {% set level = 2 %}
{% endif %}

{% set tag = 'h' ~ level %}

{% if text %}
    <{{ tag }}
        {% if id %}
            id="{{ id|e('html_attr') }}"
        {% endif %}
        {% if classes %}
            class="{{ classes|e('html_attr') }}"
        {% endif %}

        {{ html_attributes.render(attributes, ['id', 'class']) }}
    >
        {{ text|e }}
    </{{ tag }}>
{% endif %}
