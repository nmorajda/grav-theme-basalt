{#
    Pagination plugin template override.

    Rendering is delegated to the Basalt Pagination component.
#}

{% set pagination = pagination|default(page.collection.params.pagination) %}
{% set base_url = base_url|default(page.url) %}

{% if config.plugins.pagination.enabled ?? false %}
    {% include 'partials/components/pagination/pagination.html.twig' with {
        pagination: pagination,
        base_url: base_url
    } only %}
{% endif %}
