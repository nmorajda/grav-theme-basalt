<!DOCTYPE html>
<html lang="{{ (grav.language.getActive ?: grav.config.site.default_lang ?: 'en')|e('html_attr') }}" class="no-js">
<head>
{% block head %}
    {% block metadata %}
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        {% include 'partials/metadata.html.twig' %}
    {% endblock %}

    {% block title %}
        <title>
            {%- if header.title -%}
                {{ header.title|e }} |
            {%- endif -%}
            {{ site.title|e }}
        </title>
    {% endblock %}

    {% block canonical %}
        <link rel="canonical" href="{{ page.canonical(true)|e('html_attr') }}">
    {% endblock %}
{% endblock %}

{% block stylesheets %}
    {% block font_stylesheets %}{% endblock %}

    {% block theme_stylesheet %}
        {% do assets.addCss('theme://dist/css/style.css', 100) %}
    {% endblock %}

    {% if config.theme.icons.enabled ?? true %}
        {% do assets.addCss('theme://dist/css/icons.css', 90) %}
    {% endif %}
{% endblock %}

{% block javascripts %}
    {% do assets.addJs('theme://dist/js/script.js', {
        group: 'bottom',
        priority: 100
    }) %}
{% endblock %}

{% block assets deferred %}
    {{ assets.css()|raw }}
    {{ assets.js()|raw }}
{% endblock %}
</head>

<body class="{{ page.header.body_classes|e('html_attr') }}">
{% block body %}
    {% block skip_link %}
        <a class="visually-hidden-focusable" href="#main-content">
            {{ 'THEME_BASALT.SKIP_LINK'|t|e }}
        </a>
    {% endblock %}

    {% block header %}
        {% include 'partials/header.html.twig' %}
    {% endblock %}

    {% block main %}
        <main id="main-content" class="site-main" tabindex="-1">
            <div class="container">
                {% block content %}{% endblock %}
            </div>
        </main>
    {% endblock %}

    {% block footer %}
        {% include 'partials/footer.html.twig' %}
    {% endblock %}
{% endblock %}

{% block bottom %}
    {{ assets.js('bottom')|raw }}
{% endblock %}
</body>
</html>
