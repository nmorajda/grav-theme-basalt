{#
    HTML attribute rendering macros.

    Renders additional HTML attributes while allowing component-owned
    attributes to be excluded.

    Boolean values:
    - true renders a regular boolean attribute,
    - false and null regular attributes are omitted,
    - aria-* and data-* boolean values render as "true" or "false".
#}

{% macro render(attributes, excluded = []) %}
    {% for name, value in attributes %}
        {% if name not in excluded %}
            {% if name starts with 'aria-' or name starts with 'data-' %}
                {% if value is not null %}
                    {{ name }}="{{ (
                        value is same as(true)
                            ? 'true'
                            : (value is same as(false) ? 'false' : value)
                    )|e('html_attr') }}"
                {% endif %}
            {% elseif value is same as(true) %}
                {{ name }}
            {% elseif value is not same as(false) and value is not null %}
                {{ name }}="{{ value|e('html_attr') }}"
            {% endif %}
        {% endif %}
    {% endfor %}
{% endmacro %}
