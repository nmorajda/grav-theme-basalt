{#
    Navigation macros.

    Renders the visible Grav page tree for the main Navbar.

    Responsibilities:
    - render standard navigation links,
    - render dropdown navigation for pages with visible children or configured mega menus,
    - support standard and split dropdown triggers,
    - support custom mega menu templates,
    - preserve active and current page states,
    - optionally render navigation icons.

    Global configuration:
    - config.theme.dropdown.enabled
    - config.theme.navbar.dropdown.trigger
    - config.theme.icons.enabled

    Per-page dropdown configuration:

    navigation:
      dropdown:
        trigger: standard|split
        layout: mega
        template: template-name
        source: /path/to/page-or-module

    The per-page trigger overrides the global Navbar dropdown trigger.

    When layout is set to mega, the selected template is loaded from:
    partials/components/navbar/mega/

    Macros:
    - icon(name, icons_enabled)
    - render(items, dropdown_enabled, dropdown_trigger, icons_enabled, pages)
#}

{% macro icon(name, icons_enabled) %}
    {% if icons_enabled and name %}
        <i
            class="navigation-icon bi bi-{{ name|e('html_attr') }}"
            aria-hidden="true"
        ></i>
    {% endif %}
{% endmacro %}

{% macro render(items, dropdown_enabled, dropdown_trigger, icons_enabled, pages) %}
    {% for item in items %}
        {% set children = item.children.visible %}
        {% set dropdown_layout = item.header.navigation.dropdown.layout ?? 'default' %}
        {% set is_mega = dropdown_enabled and dropdown_layout == 'mega' %}
        {% set has_children = dropdown_enabled and children.count > 0 %}
        {% set has_dropdown = is_mega or has_children %}
        {% set active = item.active or item.activeChild %}

        {% set item_trigger =
            item.header.navigation.dropdown.trigger
            ?? dropdown_trigger
            ?? 'standard'
        %}

        {% if item_trigger not in ['standard', 'split'] %}
            {% set item_trigger = 'standard' %}
        {% endif %}

        {% set mega_template =
            item.header.navigation.dropdown.template
            ?? 'default'
        %}

        {% if has_dropdown %}
            {% set dropdown_id = 'navigation-dropdown-' ~ item.slug %}

            <li class="nav-item dropdown{{ item_trigger == 'split' ? ' navigation-dropdown-split' : '' }}{{ is_mega ? ' navigation-dropdown-mega' : '' }}">
                {% if item_trigger == 'split' %}
                    <a
                        class="nav-link{{ active ? ' active' : '' }}"
                        href="{{ item.url|e('html_attr') }}"
                        {% if item.active %}
                            aria-current="page"
                        {% endif %}
                    >
                        {{ _self.icon(item.header.icon, icons_enabled) }}
                        <span>{{ item.menu|e }}</span>
                    </a>

                    <button
                        id="{{ dropdown_id|e('html_attr') }}"
                        class="nav-link dropdown-toggle{{ active ? ' active' : '' }}"
                        type="button"
                        data-bs-toggle="dropdown"
                        data-bs-reference="parent"
                        aria-expanded="false"
                        aria-label="{{ 'THEME_BASALT.DROPDOWN.TOGGLE_SUBMENU'|t(item.menu)|e('html_attr') }}"
                    ></button>
                {% else %}
                    <button
                        id="{{ dropdown_id|e('html_attr') }}"
                        class="nav-link dropdown-toggle{{ active ? ' active' : '' }}"
                        type="button"
                        data-bs-toggle="dropdown"
                        aria-expanded="false"
                    >
                        {{ _self.icon(item.header.icon, icons_enabled) }}
                        <span>{{ item.menu|e }}</span>
                    </button>
                {% endif %}

                {% if is_mega %}
                    {% include [
                        'partials/components/navbar/mega/' ~ mega_template ~ '.html.twig',
                        'partials/components/navbar/mega/default.html.twig'
                    ] %}
                {% else %}
                    <ul
                        class="dropdown-menu"
                        aria-labelledby="{{ dropdown_id|e('html_attr') }}"
                    >
                        {% for child in children %}
                            {% set child_active = child.active or child.activeChild %}

                            <li>
                                <a
                                    class="dropdown-item{{ child_active ? ' active' : '' }}"
                                    href="{{ child.url|e('html_attr') }}"
                                    {% if child.active %}
                                        aria-current="page"
                                    {% endif %}
                                >
                                    {{ _self.icon(
                                        child.header.icon,
                                        icons_enabled
                                    ) }}
                                    <span>{{ child.menu|e }}</span>
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </li>
        {% else %}
            <li class="nav-item">
                <a
                    class="nav-link{{ active ? ' active' : '' }}"
                    href="{{ item.url|e('html_attr') }}"
                    {% if item.active %}
                        aria-current="page"
                    {% endif %}
                >
                    {{ _self.icon(item.header.icon, icons_enabled) }}
                    <span>{{ item.menu|e }}</span>
                </a>
            </li>
        {% endif %}
    {% endfor %}
{% endmacro %}
