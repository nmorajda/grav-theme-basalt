{#
    Badge shortcode wrapper.

    Available shortcode parameters:
    - variant
    - pill
    - classes

    Examples:

    [basalt-badge]New[/basalt-badge]

    [basalt-badge variant="success"]Active[/basalt-badge]

    [basalt-badge variant="danger" pill="true"]3[/basalt-badge]
#}

{% set pill_value = params.pill|default(false) %}
{% set pill = pill_value is same as(true)
    or pill_value is same as(1)
    or pill_value is same as('1')
    or pill_value is same as('true')
    or pill_value is same as('yes')
    or pill_value is same as('on')
%}

{% include 'partials/elements/badge.html.twig' with {
    label: content,
    variant: params.variant|default('primary'),
    pill: pill,
    classes: params.classes|default('')
} only %}
